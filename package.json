{
  "name": "multigrain",
  "version": "3.0.0",
  "description": "Tree-shakeable conversion between JSON, YAML, CSON, PLIST, and TOML.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./all": {
      "types": "./src/all.d.ts",
      "import": "./src/all.js"
    },
    "./json": {
      "types": "./src/formats/json.d.ts",
      "import": "./src/formats/json.js"
    },
    "./yaml": {
      "types": "./src/formats/yaml.d.ts",
      "import": "./src/formats/yaml.js"
    },
    "./cson": {
      "types": "./src/formats/cson.d.ts",
      "import": "./src/formats/cson.js"
    },
    "./plist": {
      "types": "./src/formats/plist.d.ts",
      "import": "./src/formats/plist.js"
    },
    "./toml": {
      "types": "./src/formats/toml.d.ts",
      "import": "./src/formats/toml.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "img/logo.png"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:compatibility": "node test/compatibility-smoke.mjs",
    "test:package": "node test/package-smoke.mjs",
    "test:tree-shaking": "vitest run test/tree-shaking.test.js",
    "test:types": "tsc --project test/tsconfig.json",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check": "npm audit --audit-level=moderate && npm test && npm run test:types && npm run test:compatibility && npm run test:package && npm run check:package && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agorischek/multigrain.git"
  },
  "keywords": [
    "JSON",
    "YAML",
    "CSON",
    "PLIST",
    "TOML",
    "serialization",
    "conversion",
    "tree-shaking"
  ],
  "author": "Alex Gorischek",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agorischek/multigrain/issues"
  },
  "homepage": "https://github.com/agorischek/multigrain#readme",
  "dependencies": {
    "cson": "^8.4.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "plist": "^5.0.0",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "esbuild": "^0.28.1",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
